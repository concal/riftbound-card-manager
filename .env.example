# --- Server (set these on Railway) ---
TCGAPI_KEY=your_tcgplayer_api_key
BETTER_AUTH_SECRET=your_generated_secret
BETTER_AUTH_URL=http://localhost:3001
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
# Comma-separated list of allowed frontend origins (e.g. your Netlify domain and custom domain)
ALLOWED_ORIGINS=http://localhost:5173,https://yourapp.netlify.app,https://yourcustomdomain.com

# --- Client (set these on Netlify) ---
# URL of your Railway backend
VITE_API_URL=http://localhost:3001
